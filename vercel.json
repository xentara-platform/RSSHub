{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "hono",
    "outputDirectory": "src",
    "rewrites": [
        {
            "source": "/favicon.ico",
            "destination": "/favicon.png"
        }
    ],
    "github": {
        "silent": true
    },
    "functions": {
        "src/**/*": {
            "includeFiles": "node_modules/**/patchright-core/browsers.json"
        }
    }
}
